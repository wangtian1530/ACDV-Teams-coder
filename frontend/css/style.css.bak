/* ============================================================ */
/*  ACDV-Teams Coder — Complete stylesheet v1.3.4              */
/* ============================================================ */

/* ---------- CSS variables ---------- */
:root {
  --bg: #1e1e1e;
  --bg-2: #252526;
  --bg-3: #2d2d30;
  --bg-4: #3c3c3c;
  --fg: #cccccc;
  --fg-dim: #858585;
  --border: #3c3c3c;
  --accent: #0e639c;
  --accent-hover: #1177bb;
  --error: #f14c4c;
  --warning: #cca700;
  --success: #4ec9b0;
  --info: #3794ff;
  --topbar-h: 42px;
  --sidebar-w: 260px;
  --mobile-bar-h: 52px;
  --bottom-h: 220px;
}

/* ---------- Reset ---------- */
* { box-sizing: border-box; }
html, body {
  margin: 0; padding: 0;
  height: 100%; width: 100%;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  font-size: 13px;
  background: var(--bg);
  color: var(--fg);
  overflow: hidden;
}
button { font-family: inherit; }
ul { margin: 0; padding: 0; list-style: none; }
input, select, textarea { font-family: inherit; }
.hidden { display: none !important; }

/* ---------- App grid ---------- */
#app {
  display: grid;
  grid-template-areas:
    "topbar topbar"
    "sidebar main";
  grid-template-columns: var(--sidebar-w) 1fr;
  grid-template-rows: var(--topbar-h) 1fr;
  height: 100vh; width: 100vw;
}

/* ---------- Topbar ---------- */
.topbar {
  grid-area: topbar;
  display: flex; align-items: center;
  gap: 8px;
  padding: 0 10px;
  background: var(--bg-2);
  border-bottom: 1px solid var(--border);
  min-height: var(--topbar-h);
  position: relative; z-index: 20;
}
.brand { display: flex; align-items: center; gap: 8px; margin-right: 12px; }
.brand-logo { display: block; flex-shrink: 0; filter: drop-shadow(0 0 3px rgba(74,170,255,.35)); }
.brand-name { font-weight: 600; font-size: 13px; letter-spacing: 0.2px; }
.top-actions { display: flex; align-items: center; gap: 4px; margin-left: auto; }
.status-dot {
  width: 8px; height: 8px; border-radius: 50%;
  background: #555; margin-right: 6px; display: inline-block;
}
.status-dot.online  { background: var(--success); box-shadow: 0 0 4px rgba(78,201,176,.5); }
.status-dot.offline { background: var(--error); }

/* ---------- Icon buttons ---------- */
.icon-btn {
  position: relative;
  background: transparent; border: 1px solid transparent;
  color: var(--fg); cursor: pointer;
  padding: 4px 8px; border-radius: 4px;
  font-size: 14px; line-height: 1;
  transition: background 0.15s, border-color 0.15s;
}
.icon-btn:hover { background: var(--bg-3); border-color: var(--border); }
.icon-btn:active { background: var(--bg-4); }
.icon-btn:disabled { opacity: 0.4; cursor: not-allowed; }
.icon-btn.small { font-size: 12px; padding: 3px 6px; }

/* ---------- ⭐ v1.3.4: Toolbar overflow ---------- */
/* Ẩn/hiện theo breakpoint — logic toggle ở cuối file trong @media */
.mobile-only { display: none !important; }

/* Chấm đỏ báo Problems trên nút More (mirror từ #problemsBtn .badge) */
#moreBtn .mobile-badge-dot {
  position: absolute;
  top: 2px; right: 2px;
  width: 6px; height: 6px;
  border-radius: 50%;
  background: var(--warning);
  pointer-events: none;
  box-shadow: 0 0 0 1.5px var(--bg-2);
}
#moreBtn .mobile-badge-dot.error { background: var(--error); }

/* ---------- ⭐ v1.3.4: Mobile overflow menu ---------- */
.top-menu {
  position: absolute;
  top: calc(100% + 2px);
  right: 8px;
  background: var(--bg-2);
  border: 1px solid var(--border);
  border-radius: 8px;
  box-shadow: 0 8px 24px rgba(0,0,0,.55);
  min-width: 200px;
  max-width: 90vw;
  z-index: 200;
  padding: 4px 0;
  animation: topMenuIn 0.12s ease-out;
}
@keyframes topMenuIn {
  from { opacity: 0; transform: translateY(-4px); }
  to   { opacity: 1; transform: translateY(0); }
}
.top-menu.hidden { display: none; }
.top-menu-item {
  display: flex; align-items: center; gap: 10px;
  width: 100%;
  padding: 11px 16px;
  background: transparent;
  border: none;
  color: var(--fg);
  text-align: left;
  font-size: 14px;
  cursor: pointer;
  -webkit-tap-highlight-color: transparent;
}
.top-menu-item:hover  { background: var(--bg-3); }
.top-menu-item:active { background: var(--bg-4); }
.top-menu-item.disabled { opacity: 0.35; pointer-events: none; }
.top-menu-item .mi-icon {
  display: inline-block;
  width: 18px;
  text-align: center;
  flex-shrink: 0;
}
.top-menu-item .mi-label { flex: 1; }
.top-menu-divider {
  height: 1px;
  background: var(--border);
  margin: 4px 8px;
}

/* ---------- Sidebar ---------- */
.sidebar {
  grid-area: sidebar;
  background: var(--bg-2);
  border-right: 1px solid var(--border);
  display: flex; flex-direction: column;
  overflow: hidden;
  min-width: 0;
}
.sidebar-tabs { display: flex; border-bottom: 1px solid var(--border); flex-shrink: 0; }
.sidebar-tabs .tab {
  flex: 1;
  background: transparent; border: none;
  color: var(--fg-dim);
  padding: 8px 10px; cursor: pointer;
  font-size: 11px; text-transform: uppercase; letter-spacing: 0.4px;
  border-bottom: 2px solid transparent;
}
.sidebar-tabs .tab:hover  { color: var(--fg); }
.sidebar-tabs .tab.active { color: var(--fg); border-bottom-color: var(--accent); }
.tab-body { flex: 1; overflow-y: auto; display: flex; flex-direction: column; min-height: 0; }
.sidebar-head {
  display: flex; align-items: center; justify-content: space-between;
  padding: 8px 10px;
  font-size: 11px; text-transform: uppercase; letter-spacing: 0.5px;
  color: var(--fg-dim);
  border-bottom: 1px solid var(--border);
  flex-shrink: 0;
}
.row-actions { display: flex; gap: 2px; }

/* ---------- Project list ---------- */
.project-list { padding: 4px 0; overflow-y: auto; flex: 1; }
.project-item {
  display: flex; align-items: center; gap: 6px;
  padding: 6px 12px; cursor: pointer;
  font-size: 12px; color: var(--fg);
  border-left: 2px solid transparent;
}
.project-item:hover  { background: var(--bg-3); }
.project-item.active { background: rgba(14,99,156,.25); border-left-color: var(--accent); }
.project-empty {
  padding: 16px 12px; color: var(--fg-dim);
  font-style: italic; text-align: center; font-size: 12px;
}

/* ---------- File tree ---------- */
.file-tree { padding: 4px 0; overflow-y: auto; flex: 1; font-size: 12px; }
.file-children { padding-left: 12px; }
.file-item {
  display: flex; align-items: center; gap: 6px;
  padding: 4px 12px; cursor: pointer; user-select: none;
  color: var(--fg); font-size: 12px;
}
.file-item:hover { background: var(--bg-3); }
.file-item .chev {
  display: inline-block; width: 12px;
  color: var(--fg-dim);
  font-family: "SF Mono", Menlo, Consolas, monospace;
  font-size: 11px;
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
.file-item .run-inline { margin-left: auto; opacity: 0; transition: opacity 0.15s; }
.file-item:hover .run-inline { opacity: 1; }

/* ---------- Main area ---------- */
.main-area {
  grid-area: main;
  display: flex; flex-direction: column;
  overflow: hidden;
  min-width: 0; min-height: 0;
}

/* ---------- Editor tabs ---------- */
.editor-tabs {
  display: flex; overflow-x: auto;
  background: var(--bg-2);
  border-bottom: 1px solid var(--border);
  flex-shrink: 0; min-height: 34px;
}
.editor-tab {
  display: flex; align-items: center; gap: 6px;
  padding: 6px 10px;
  background: var(--bg-3);
  color: var(--fg-dim);
  border-right: 1px solid var(--border);
  cursor: pointer;
  font-size: 12px; white-space: nowrap; user-select: none;
}
.editor-tab:hover  { color: var(--fg); }
.editor-tab.active { background: var(--bg); color: var(--fg); border-bottom: 2px solid var(--accent); }
.editor-tab .close {
  width: 16px; height: 16px;
  display: inline-flex; align-items: center; justify-content: center;
  border-radius: 3px;
  color: var(--fg-dim);
  font-size: 14px;
}
.editor-tab .close:hover { background: var(--bg-4); color: var(--fg); }
.editor-tab.dirty .close::before { content: "●"; color: var(--fg); }
.editor-tab.dirty .close { font-size: 0; }
.editor-tab.dirty .close::before { font-size: 10px; }

/* ---------- Editor wrap ---------- */
.editor-wrap {
  flex: 1; position: relative; overflow: hidden;
  background: var(--bg); min-height: 0;
}
.editor { display: none; }
.editor-empty {
  position: absolute; inset: 0;
  display: flex; align-items: center; justify-content: center;
  background: var(--bg);
}
.empty-inner { text-align: center; color: var(--fg-dim); }
.empty-inner h2 { font-size: 22px; margin: 0 0 8px; color: var(--fg); font-weight: 500; }
.empty-inner p  { margin: 0 0 20px; font-size: 13px; }

.CodeMirror { height: 100% !important; font-family: "SF Mono", Menlo, Consolas, monospace; font-size: 13px; }
.CodeMirror-scroll { min-height: 100%; }

/* ---------- Bottom panel ---------- */
.bottom-panel {
  border-top: 1px solid var(--border);
  background: var(--bg-2);
  height: var(--bottom-h);
  display: flex; flex-direction: column;
  flex-shrink: 0; overflow: hidden;
}
.bottom-panel.collapsed { height: 34px; }
.panel-head {
  display: flex; align-items: center; justify-content: space-between;
  padding: 0 10px;
  border-bottom: 1px solid var(--border);
  min-height: 34px; flex-shrink: 0;
}
.panel-tabs { display: flex; gap: 2px; }
.ptab {
  background: transparent; border: none;
  color: var(--fg-dim);
  padding: 6px 10px; cursor: pointer;
  font-size: 11px; text-transform: uppercase; letter-spacing: 0.3px;
  border-bottom: 2px solid transparent;
}
.ptab:hover  { color: var(--fg); }
.ptab.active { color: var(--fg); border-bottom-color: var(--accent); }
.panel-actions { display: flex; gap: 4px; }
.panel-pane { flex: 1; overflow: hidden; display: flex; flex-direction: column; min-height: 0; }
.panel-body {
  flex: 1; overflow-y: auto; margin: 0;
  padding: 8px 12px;
  font-family: "SF Mono", Menlo, Consolas, monospace;
  font-size: 12px;
  white-space: pre-wrap; word-break: break-word;
  color: var(--fg);
  background: var(--bg);
}
.run-header {
  padding: 6px 12px;
  border-bottom: 1px solid var(--border);
  font-size: 11px; color: var(--fg-dim);
  background: var(--bg-2);
}

/* ---------- Mobile bar ---------- */
.mobile-bar { display: none; }

/* ---------- Buttons ---------- */
.btn {
  display: inline-flex; align-items: center; justify-content: center;
  gap: 4px;
  background: var(--bg-4);
  color: var(--fg);
  border: 1px solid var(--border);
  padding: 6px 14px;
  border-radius: 4px;
  font-size: 13px; cursor: pointer;
  transition: background 0.15s, border-color 0.15s;
}
.btn:hover { background: #4a4a4a; }
.btn.primary { background: var(--accent); border-color: var(--accent); color: #fff; }
.btn.primary:hover { background: var(--accent-hover); border-color: var(--accent-hover); }
.btn.btn-sm { padding: 4px 10px; font-size: 12px; border-radius: 4px; }
.btn.btn-success { background: #1a7f37; border-color: #1a7f37; color: #fff; }
.btn.btn-success:hover { background: #2a9d4d; }
.btn.btn-danger  { background: #a72f2f; border-color: #a72f2f; color: #fff; }
.btn.btn-danger:hover { background: #c94242; }
.btn.btn-warning { background: #8f6b00; border-color: #8f6b00; color: #fff; }
.btn.btn-warning:hover { background: #b08500; }
.btn.btn-info { background: #0e639c; border-color: #0e639c; color: #fff; }
.btn.btn-info:hover { background: #1177bb; }
.btn.btn-secondary { background: var(--bg-4); border-color: var(--border); }

/* ---------- Module list ---------- */
.module-list { padding: 4px 0; overflow-y: auto; flex: 1; }
.module-item {
  display: flex; align-items: center; gap: 6px;
  padding: 6px 10px;
  font-size: 12px;
}
.module-item:hover { background: var(--bg-3); }
.module-version { color: var(--fg-dim); font-size: 10px; margin-left: auto; }
.module-actions { display: flex; gap: 2px; }
.module-empty {
  padding: 16px 12px; color: var(--fg-dim);
  font-style: italic; text-align: center; font-size: 12px;
}
.module-actions-container {
  padding: 8px 10px;
  border-top: 1px solid var(--border);
  margin-top: 8px;
}
.module-actions-group { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 10px; }
.module-actions-head {
  width: 100%;
  font-size: 10px; text-transform: uppercase;
  color: var(--fg-dim);
  margin-bottom: 4px; letter-spacing: 0.5px;
}

/* ---------- Modals ---------- */
.modal {
  position: fixed; inset: 0;
  background: rgba(0,0,0,.55);
  display: flex; align-items: center; justify-content: center;
  z-index: 1000; padding: 16px;
}
.modal.hidden { display: none !important; }
.modal-card {
  background: var(--bg-2);
  border: 1px solid var(--border);
  border-radius: 8px;
  padding: 16px;
  width: 100%;
  max-width: 380px;
  box-shadow: 0 8px 32px rgba(0,0,0,.5);
}
.modal-card h3 { margin: 0 0 12px; font-size: 15px; font-weight: 600; }
.modal-card input[type="text"],
.modal-card select {
  width: 100%;
  background: var(--bg);
  border: 1px solid var(--border);
  color: var(--fg);
  padding: 8px 10px;
  border-radius: 4px;
  font-size: 13px;
  margin-bottom: 8px;
  outline: none;
}
.modal-card input[type="text"]:focus,
.modal-card select:focus { border-color: var(--accent); }
.modal-actions { display: flex; justify-content: flex-end; gap: 8px; margin-top: 8px; }

/* ---------- Logs modal ---------- */
.logs-modal-card {
  max-width: 900px !important;
  width: 92% !important;
  height: 80vh;
  display: flex; flex-direction: column;
}
.logs-body {
  flex: 1;
  display: grid;
  grid-template-columns: 260px 1fr;
  gap: 8px;
  min-height: 0;
}
.log-list {
  background: var(--bg);
  border: 1px solid var(--border);
  border-radius: 4px;
  overflow-y: auto;
}
.log-item {
  padding: 8px 10px;
  cursor: pointer;
  display: flex; align-items: center; gap: 6px;
  border-bottom: 1px solid var(--border);
  font-size: 12px;
}
.log-item:hover { background: var(--bg-3); }
.log-item .log-name { flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.log-item .log-meta { color: var(--fg-dim); font-size: 10px; }
.log-item-empty { padding: 12px; color: var(--fg-dim); font-style: italic; }
.log-preview {
  background: var(--bg);
  border: 1px solid var(--border);
  border-radius: 4px;
  padding: 10px;
  overflow: auto;
  margin: 0;
  font-family: "SF Mono", Menlo, Consolas, monospace;
  font-size: 12px;
  white-space: pre-wrap; word-break: break-word;
  color: var(--fg);
}

/* ==================== Diagnostics ==================== */
.acdv-diag-error   { text-decoration: underline wavy #f14c4c; background: rgba(241,76,76,0.06); }
.acdv-diag-warning { text-decoration: underline wavy #cca700; background: rgba(204,167,0,0.06); }
.acdv-diag-info    { text-decoration: underline wavy #3794ff; background: rgba(55,148,255,0.06); }
.acdv-diag-hint    { text-decoration: underline dotted #888; }
.cm-flash-line     { background: rgba(255, 235, 59, 0.20) !important; transition: background 0.4s; }

#problemsList {
  flex: 1; overflow-y: auto; min-height: 0; padding: 8px;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  font-size: 12px; white-space: normal; word-break: normal;
}
.problems-empty { color: var(--fg-dim); padding: 20px; text-align: center; font-style: italic; }
.problem-group { margin-bottom: 8px; }
.problem-group-header {
  font-weight: 600;
  padding: 4px 8px;
  background: rgba(255,255,255,.04);
  border-radius: 3px; margin-bottom: 2px;
  color: #ccc; font-size: 11px;
  text-transform: uppercase; letter-spacing: 0.3px;
}
.problem-row {
  display: flex; align-items: center; gap: 8px;
  padding: 4px 8px;
  cursor: pointer; border-radius: 3px;
  font-size: 12px;
}
.problem-row:hover { background: rgba(255,255,255,.06); }
.problem-sev { width: 14px; text-align: center; flex-shrink: 0; }
.problem-row.acdv-diag-error   .problem-sev { color: #f14c4c; }
.problem-row.acdv-diag-warning .problem-sev { color: #cca700; }
.problem-row.acdv-diag-info    .problem-sev { color: #3794ff; }
.problem-row.acdv-diag-hint    .problem-sev { color: #888; }
.problem-msg { flex: 1; color: #ddd; overflow: hidden; text-overflow: ellipsis; }
.problem-loc { color: #888; font-family: "SF Mono", Menlo, Consolas, monospace; font-size: 11px; flex-shrink: 0; }
.problem-src { color: #666; font-size: 10px; font-style: italic; flex-shrink: 0; }

#problemsBtn .badge {
  position: absolute; top: -2px; right: -2px;
  background: #cca700; color: #000;
  border-radius: 8px; padding: 0 4px;
  font-size: 9px; font-weight: bold;
  min-width: 14px; text-align: center; line-height: 14px;
  pointer-events: none;
}
#problemsBtn .badge.badge-error { background: #f14c4c; color: #fff; }
#problemsBtn .badge.badge-warn  { background: #cca700; color: #000; }

/* ---------- Settings modal ---------- */
.modal-content.settings-modal {
  background: #1e1e1e;
  color: var(--fg);
  border-radius: 8px;
  width: 90vw; max-width: 820px;
  height: 72vh; max-height: 640px;
  display: flex; flex-direction: column;
  box-shadow: 0 8px 32px rgba(0,0,0,.5);
  border: 1px solid var(--border);
}
.modal-header {
  display: flex; align-items: center; justify-content: space-between;
  padding: 12px 16px;
  border-bottom: 1px solid var(--border);
}
.modal-header h2 { margin: 0; font-size: 16px; font-weight: 600; }
.modal-close {
  background: none; border: none;
  color: var(--fg-dim); font-size: 22px;
  cursor: pointer; line-height: 1; padding: 0 4px;
}
.modal-close:hover { color: var(--fg); }

.settings-tabs {
  display: flex; gap: 2px;
  padding: 8px 16px 0;
  border-bottom: 1px solid var(--border);
  overflow-x: auto; flex-shrink: 0;
}
.settings-tab {
  background: transparent; border: none;
  color: var(--fg-dim);
  padding: 8px 12px; cursor: pointer;
  font-size: 13px;
  border-bottom: 2px solid transparent;
  white-space: nowrap;
}
.settings-tab:hover  { color: var(--fg); }
.settings-tab.active { color: #4af; border-bottom-color: #4af; }

.settings-content { flex: 1; overflow-y: auto; padding: 16px; min-height: 0; }
.settings-section { max-width: 620px; }
.settings-field { margin-bottom: 16px; }
.settings-label { display: block; font-size: 13px; margin-bottom: 4px; font-weight: 500; }
.settings-desc  { font-size: 11px; color: var(--fg-dim); margin-bottom: 6px; }
.settings-input {
  background: #2a2a2a;
  border: 1px solid #444;
  color: var(--fg);
  padding: 6px 10px;
  border-radius: 4px;
  font-size: 13px;
  width: 100%; max-width: 320px;
}
.settings-input:focus { border-color: #4af; outline: none; }
input.settings-input[type=checkbox] { width: auto; }

.settings-savebar {
  margin-top: 20px; padding-top: 12px;
  border-top: 1px solid var(--border);
  display: flex; gap: 8px;
}
.btn-primary {
  background: var(--accent); color: #fff;
  border: 1px solid var(--accent);
  padding: 6px 16px; border-radius: 4px;
  cursor: pointer; font-size: 13px; font-weight: 500;
}
.btn-primary:hover { background: var(--accent-hover); }

.overlays-table { margin-top: 12px; }
.overlays-row {
  display: flex; align-items: center; gap: 12px;
  padding: 8px; border-bottom: 1px solid #2a2a2a;
}
.overlays-name { flex: 1; font-size: 13px; }
.overlays-name small { color: var(--fg-dim); font-size: 11px; margin-left: 4px; }
.overlays-toggle { display: flex; align-items: center; gap: 4px; cursor: pointer; font-size: 12px; }

.module-settings-item {
  background: #252525;
  border-radius: 6px;
  margin-bottom: 12px;
  padding: 12px;
}
.module-settings-header {
  display: flex; align-items: baseline; gap: 8px;
  margin-bottom: 12px; padding-bottom: 8px;
  border-bottom: 1px solid var(--border);
}
.module-settings-header strong { font-size: 14px; }
.module-settings-header small  { color: var(--fg-dim); font-size: 11px; }
.module-settings-desc { color: var(--fg-dim); font-size: 12px; font-style: italic; margin-left: auto; }
.module-settings-body { margin-bottom: 8px; }

#overlayBanner button {
  background: #444; color: #fff;
  border: none; padding: 3px 8px; border-radius: 3px;
  cursor: pointer; font-size: 11px;
}
#overlayBanner button:hover { background: #555; }

/* ---------- About tab ---------- */
.about-hero {
  display: flex; align-items: center; gap: 16px;
  padding: 16px;
  background: linear-gradient(135deg, rgba(14,99,156,.18), rgba(17,119,187,.05));
  border: 1px solid rgba(74,170,255,.22);
  border-radius: 8px;
  margin-bottom: 16px;
}
.about-hero-logo { flex-shrink: 0; }
.about-hero-text h3 { margin: 0 0 4px; font-size: 18px; }
.about-hero-text .version { color: #4af; font-family: "SF Mono", Menlo, Consolas, monospace; font-size: 12px; }
.about-hero-text .tagline { color: var(--fg-dim); font-size: 12px; margin-top: 4px; }

.about-card {
  background: #252525;
  border: 1px solid var(--border);
  border-radius: 6px;
  padding: 12px 16px;
  margin-bottom: 12px;
}
.about-card h4 {
  margin: 0 0 10px; font-size: 12px; color: #4af;
  text-transform: uppercase; letter-spacing: 0.5px; font-weight: 600;
}
.about-grid {
  display: grid;
  grid-template-columns: 110px 1fr;
  gap: 4px 12px;
  font-size: 12px;
}
.about-grid .label { color: var(--fg-dim); }
.about-grid .value { color: var(--fg); font-family: "SF Mono", Menlo, Consolas, monospace; word-break: break-all; }
.about-details {
  margin-bottom: 6px;
  border-left: 2px solid rgba(74,170,255,.3);
  padding-left: 10px;
}
.about-details summary {
  cursor: pointer; font-size: 13px;
  padding: 4px 0; font-weight: 500; user-select: none;
}
.about-details summary:hover { color: #4af; }
.about-details[open] summary  { color: #4af; }
.about-details .content {
  font-size: 12px; color: var(--fg-dim);
  padding: 4px 0 8px; line-height: 1.65;
}
.about-details .content ul { margin: 4px 0; padding-left: 20px; }
.about-details .content li { margin: 3px 0; }
.about-details .content code {
  background: #2a2a2a; padding: 1px 5px;
  border-radius: 3px;
  font-family: "SF Mono", Menlo, Consolas, monospace;
  font-size: 11px; color: #e0e0e0; border: 1px solid #333;
}
.about-details .content strong { color: var(--fg); }
.about-links a {
  color: #4af; text-decoration: none;
  font-size: 12px; margin-right: 14px;
  font-family: "SF Mono", Menlo, Consolas, monospace;
}
.about-links a:hover { text-decoration: underline; }

/* ==================== Responsive ==================== */
@media (max-width: 768px) {
  #app {
    grid-template-areas:
      "topbar"
      "main"
      "mobilebar";
    grid-template-columns: 1fr;
    grid-template-rows: var(--topbar-h) 1fr var(--mobile-bar-h);
  }

  /* ⭐ v1.3.4: topbar z-index cao hơn sidebar (100) để dropdown ⋯ nổi lên trên */
  .topbar { z-index: 200; }

  /* ⭐ v1.3.4: ẩn nút desktop, hiện nút ⋯ */
  .desktop-only { display: none !important; }
  .mobile-only  { display: inline-flex !important; }

  .sidebar {
    position: fixed;
    top: var(--topbar-h); left: 0; bottom: var(--mobile-bar-h);
    width: 85vw; max-width: 320px;
    z-index: 100;
    transform: translateX(-100%);
    transition: transform 0.25s;
    box-shadow: 4px 0 12px rgba(0,0,0,.4);
  }
  .sidebar.open { transform: translateX(0); }
  .brand-name { display: none; }
  .mobile-bar {
    grid-area: mobilebar;
    display: flex;
    border-top: 1px solid var(--border);
    background: var(--bg-2);
  }
  .mobile-bar .mb {
    flex: 1;
    background: transparent; border: none;
    color: var(--fg-dim);
    padding: 6px 4px;
    font-size: 16px; cursor: pointer;
    display: flex; flex-direction: column;
    align-items: center; gap: 2px;
  }
  .mobile-bar .mb span { font-size: 9px; text-transform: uppercase; letter-spacing: 0.3px; }
  .mobile-bar .mb.active { color: #4af; }
  .about-hero { flex-direction: column; text-align: center; }
  .about-grid { grid-template-columns: 90px 1fr; }
  .logs-body  { grid-template-columns: 1fr; grid-template-rows: 140px 1fr; }
}

/* ==================== Code folding ==================== */
.CodeMirror-foldgutter {
  width: 14px;
  text-align: center;
}
.CodeMirror-foldgutter-open,
.CodeMirror-foldgutter-folded {
  cursor: pointer;
  color: #666;
  font-size: 11px;
  line-height: 1.3;
}
.CodeMirror-foldgutter-open:hover,
.CodeMirror-foldgutter-folded:hover { color: #4af; }
.CodeMirror-foldgutter-open:after   { content: "▾"; }
.CodeMirror-foldgutter-folded:after { content: "▸"; }

.CodeMirror-foldmarker {
  color: #4af;
  text-shadow: none;
  font-family: "SF Mono", Menlo, Consolas, monospace;
  font-size: 11px;
  padding: 0 5px;
  background: rgba(74,170,255,.15);
  border: 1px solid rgba(74,170,255,.3);
  border-radius: 3px;
  cursor: pointer;
}
.CodeMirror-foldmarker:hover { background: rgba(74,170,255,.25); }

/* ==================== Terminal ==================== */
#pane-terminal {
  padding: 0;
  background: #1e1e1e;
}

.terminal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 4px 10px;
  background: var(--bg-2);
  border-bottom: 1px solid var(--border);
  font-size: 11px;
  color: var(--fg-dim);
  flex-shrink: 0;
  min-height: 26px;
}
.terminal-status {
  font-family: "SF Mono", Menlo, Consolas, monospace;
  font-size: 11px;
  color: var(--fg-dim);
}
.terminal-status.online     { color: var(--success); }
.terminal-status.connecting { color: var(--warning); }
.terminal-status.offline    { color: var(--fg-dim); }

.terminal-actions {
  display: flex;
  gap: 2px;
}

#terminalContainer {
  flex: 1;
  min-height: 0;
  width: 100%;
  padding: 2px 4px;
  background: #1e1e1e;
  overflow: hidden;
}

#terminalContainer .xterm {
  height: 100%;
  padding: 2px;
}
#terminalContainer .xterm-viewport {
  background-color: #1e1e1e !important;
}

@media (max-width: 768px) {
  #pane-terminal {
    min-height: 180px;
  }
}
/* ============================================================ */
/*  ⭐ v1.4.0: Loading overlay + Storage UI                     */
/* ============================================================ */

.app-loading-overlay {
  position: fixed;
  inset: 0;
  background: rgba(30, 30, 30, 0.92);
  backdrop-filter: blur(4px);
  z-index: 999998;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 20px;
  color: var(--fg);
  font-family: -apple-system, sans-serif;
  transition: opacity 0.25s;
}
.app-loading-overlay.hidden {
  display: none !important;
}
.app-loading-spinner {
  width: 48px;
  height: 48px;
  border: 4px solid rgba(74, 170, 255, 0.2);
  border-top-color: #4af;
  border-radius: 50%;
  animation: acdvSpin 0.9s linear infinite;
}
@keyframes acdvSpin {
  to { transform: rotate(360deg); }
}
.app-loading-text {
  font-size: 14px;
  color: var(--fg-dim);
  letter-spacing: 0.3px;
}

.storage-card {
  max-width: 680px !important;
  width: 92% !important;
  max-height: 85vh;
  display: flex;
  flex-direction: column;
}
.storage-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12px;
  padding-bottom: 10px;
  border-bottom: 1px solid var(--border);
}
.storage-header h3 {
  margin: 0;
  font-size: 15px;
  font-weight: 600;
}

.storage-usage { margin-bottom: 14px; }
.storage-usage-text {
  display: flex;
  justify-content: space-between;
  font-size: 12px;
  margin-bottom: 6px;
  color: var(--fg-dim);
}
.storage-percent { font-weight: 600; }
.storage-percent.ok     { color: var(--success); }
.storage-percent.warn   { color: var(--warning); }
.storage-percent.danger { color: var(--error); }

.storage-bar {
  height: 8px;
  background: var(--bg-3);
  border-radius: 4px;
  overflow: hidden;
  border: 1px solid var(--border);
}
.storage-bar-fill {
  height: 100%;
  transition: width 0.3s, background 0.3s;
}
.storage-bar-fill.ok     { background: var(--success); }
.storage-bar-fill.warn   { background: var(--warning); }
.storage-bar-fill.danger { background: var(--error); }

.storage-warn-msg {
  margin-top: 8px;
  font-size: 11px;
  color: var(--warning);
  padding: 6px 10px;
  background: rgba(204, 167, 0, 0.1);
  border: 1px solid rgba(204, 167, 0, 0.3);
  border-radius: 4px;
}

.storage-actions {
  display: flex;
  gap: 6px;
  flex-wrap: wrap;
  margin-bottom: 12px;
  padding-bottom: 12px;
  border-bottom: 1px solid var(--border);
}

.storage-files {
  flex: 1;
  min-height: 120px;
  max-height: 380px;
  overflow-y: auto;
  border: 1px solid var(--border);
  border-radius: 4px;
  background: var(--bg);
}
.storage-loading,
.storage-empty,
.storage-error {
  padding: 30px 20px;
  text-align: center;
  color: var(--fg-dim);
  font-size: 12px;
  font-style: italic;
}
.storage-error { color: var(--error); }

.storage-file-row {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 8px 12px;
  font-size: 12px;
  border-bottom: 1px solid var(--border);
}
.storage-file-row:last-child { border-bottom: none; }
.storage-file-row:hover { background: var(--bg-3); }
.storage-file-icon { flex-shrink: 0; }
.storage-file-name {
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: var(--fg);
}
.storage-file-size {
  color: var(--fg-dim);
  font-family: "SF Mono", Menlo, monospace;
  font-size: 11px;
  flex-shrink: 0;
}
.storage-file-actions {
  display: flex;
  gap: 2px;
  flex-shrink: 0;
}

.storage-upload-progress {
  margin-top: 10px;
  padding: 10px;
  background: var(--bg-3);
  border-radius: 4px;
  border: 1px solid var(--border);
}
.storage-upload-progress.hidden { display: none; }
.progress-label {
  font-size: 11px;
  color: var(--fg-dim);
  margin-bottom: 6px;
}
.progress-bar {
  height: 6px;
  background: var(--bg);
  border-radius: 3px;
  overflow: hidden;
}
.progress-fill {
  height: 100%;
  width: 0;
  background: var(--accent-hover);
  transition: width 0.2s;
}

.module-storage-mini {
  width: 40px;
  height: 4px;
  background: var(--bg-3);
  border-radius: 2px;
  overflow: hidden;
  flex-shrink: 0;
}
.mini-bar {
  width: 100%;
  height: 100%;
}
.mini-fill {
  height: 100%;
  transition: width 0.3s;
}
.mini-fill.ok     { background: var(--success); }
.mini-fill.warn   { background: var(--warning); }
.mini-fill.danger { background: var(--error); }
/* ============================================================ */
/*  ⭐ v1.4.1 FIX: Welcome screen bị che + fold không hoạt động  */
/* ============================================================ */

/* FIX 1: Override .editor-empty cũ (v1.3.4) — dùng !important để chắc chắn */
.editor-empty {
  position: absolute !important;
  inset: 0 !important;
  background: var(--bg) !important;
  overflow: hidden !important;
  display: block !important;
  align-items: initial !important;
  justify-content: initial !important;
}

/* FIX 2: welcome-screen PHẢI fill hết chiều cao, các child dùng flex properly */
.welcome-screen {
  display: flex !important;
  flex-direction: column !important;
  height: 100% !important;
  min-height: 0 !important;
  overflow: hidden !important;
  background: var(--bg) !important;
}

.welcome-header {
  display: flex !important;
  align-items: center !important;
  gap: 12px !important;
  flex-wrap: wrap !important;
  padding: 16px 24px !important;
  background: var(--bg-2) !important;
  border-bottom: 1px solid var(--border) !important;
  flex-shrink: 0 !important;
  min-height: fit-content !important;
}

.welcome-header h2 {
  margin: 0 !important;
  font-size: 16px !important;
  font-weight: 600 !important;
  color: var(--fg) !important;
  flex: 1 1 100% !important;   /* ⭐ Chiếm full hàng để không bị che */
  min-width: 0 !important;
  line-height: 1.3 !important;
}

.welcome-header .btn.primary {
  flex: 0 0 auto !important;
}

.welcome-header #refreshReadmeBtn {
  flex: 0 0 auto !important;
}

.welcome-header p {
  margin: 0 !important;
  font-size: 12px !important;
  color: var(--fg-dim) !important;
  flex: 1 1 100% !important;   /* ⭐ Xuống dòng riêng, không chèn giữa h2 và buttons */
  order: initial !important;
  line-height: 1.4 !important;
}

/* FIX 3: welcome-readme PHẢI scroll được — không bị cắt chữ */
.welcome-readme {
  flex: 1 1 auto !important;
  min-height: 0 !important;      /* ⭐ Quan trọng: cho phép shrink trong flex column */
  overflow-y: auto !important;
  overflow-x: hidden !important;
  padding: 24px 40px 48px !important;
  color: var(--fg) !important;
  font-size: 14px !important;
  line-height: 1.65 !important;
  max-width: 100% !important;
  word-wrap: break-word !important;
  overflow-wrap: break-word !important;
}

/* FIX 4: markdown content không tràn */
.welcome-readme > * {
  max-width: 100% !important;
}

.welcome-readme pre {
  max-width: 100% !important;
  overflow-x: auto !important;
  white-space: pre !important;
  word-wrap: normal !important;
}

.welcome-readme pre code {
  white-space: pre !important;
  word-wrap: normal !important;
  word-break: normal !important;
}

.welcome-readme code {
  word-break: break-word !important;
}

.welcome-readme table {
  display: block !important;
  overflow-x: auto !important;
  max-width: 100% !important;
}

.welcome-readme img {
  max-width: 100% !important;
  height: auto !important;
}

/* FIX 5: Mobile welcome */
@media (max-width: 768px) {
  .welcome-header {
    padding: 12px 14px !important;
    gap: 8px !important;
  }
  .welcome-header h2 {
    font-size: 14px !important;
    flex: 1 1 100% !important;
  }
  .welcome-header p {
    font-size: 11px !important;
  }
  .welcome-readme {
    padding: 14px 16px 40px !important;
    font-size: 13px !important;
  }
  .welcome-readme h1 { font-size: 19px !important; }
  .welcome-readme h2 { font-size: 16px !important; margin-top: 22px !important; }
  .welcome-readme h3 { font-size: 14px !important; }
  .welcome-readme pre {
    padding: 10px 12px !important;
  }
  .welcome-readme pre code { font-size: 11px !important; }
  .welcome-readme table { font-size: 12px !important; }
  .welcome-readme th,
  .welcome-readme td { padding: 4px 8px !important; }
}