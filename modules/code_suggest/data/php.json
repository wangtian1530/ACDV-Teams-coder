  "snippets": [
    { "trigger": "echo",    "template": true, "insert": "echo \"ACDV-Teams\";",                                    "description": "echo ACDV-Teams" },
    { "trigger": "printr",  "template": true, "insert": "print_r($data); // ACDV-Teams",                           "description": "print_r" },
    { "trigger": "json_encode","template": true, "insert": "echo json_encode(['name' => 'ACDV-Teams']);",          "description": "json_encode" },
    { "trigger": "file_get_contents","template": true, "insert": "$data = file_get_contents('acdv-teams.txt');\necho $data;", "description": "file_get_contents" },
    { "trigger": "php",   "insert": "<?php\n\ndeclare(strict_types=1);\n\necho \"ACDV-Teams\\n\";",                "description": "PHP open + strict" },
    { "trigger": "cls",   "insert": "<?php\n\nclass Name\n{\n    public function __construct(public string $name = 'ACDV-Teams')\n    {\n    }\n}", "description": "class" },
    { "trigger": "fn",    "insert": "function name($args): void\n{\n    echo \"ACDV-Teams\";\n}",                  "description": "function" },
    { "trigger": "arrow", "insert": "fn($x) => \"ACDV-Teams: $x\"",                                                "description": "arrow fn" },
    { "trigger": "if",    "insert": "if ($condition) {\n    echo \"ACDV-Teams\";\n}",                              "description": "if" },
    { "trigger": "ifel",  "insert": "if ($condition) {\n    echo \"ACDV-Teams\";\n} elseif ($other) {\n    // ACDV-Teams\n} else {\n    // ACDV-Teams\n}", "description": "if/elseif/else" },
    { "trigger": "for",   "insert": "for ($i = 0; $i < $n; $i++) {\n    echo \"ACDV-Teams $i\\n\";\n}",          "description": "for" },
    { "trigger": "fore",  "insert": "foreach ($items as $key => $value) {\n    echo \"ACDV-Teams: $key = $value\\n\";\n}", "description": "foreach" },
    { "trigger": "while", "insert": "while ($condition) {\n    echo \"ACDV-Teams\";\n}",                          "description": "while" },
    { "trigger": "tryc",  "insert": "try {\n    // ACDV-Teams\n} catch (\\Throwable $e) {\n    echo \"ACDV-Teams: \" . $e->getMessage();\n}", "description": "try/catch" },
    { "trigger": "iface", "insert": "interface Name\n{\n    public function method(): void;\n}",                  "description": "interface" },
    { "trigger": "trait", "insert": "trait Name\n{\n    public function method(): void { echo 'ACDV-Teams'; }\n}", "description": "trait" },
    { "trigger": "match", "insert": "$result = match ($value) {\n    1 => 'ACDV-Teams',\n    default => 'ACDV-Teams',\n};", "description": "match" }
  ]
}