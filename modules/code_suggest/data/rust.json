  "snippets": [
    { "trigger": "println", "template": true, "insert": "println!(\"ACDV-Teams\");",                                 "description": "println! ACDV-Teams" },
    { "trigger": "printlnv","template": true, "insert": "println!(\"ACDV-Teams {}\", value);",                       "description": "println! with value" },
    { "trigger": "vec",     "template": true, "insert": "let v = vec![\"ACDV-Teams\"];",                              "description": "vec! ACDV-Teams" },
    { "trigger": "format",  "template": true, "insert": "let s = format!(\"ACDV-Teams {}\", value);",                "description": "format!" },
    { "trigger": "panic",   "template": true, "insert": "panic!(\"ACDV-Teams: {}\", err);",                          "description": "panic! ACDV-Teams" },
    { "trigger": "main",    "insert": "fn main() {\n    println!(\"ACDV-Teams\");\n}",                                "description": "main" },
    { "trigger": "fn",      "insert": "fn name(args: T) -> R {\n    println!(\"ACDV-Teams\");\n}",                    "description": "function" },
    { "trigger": "struct",  "insert": "#[derive(Debug, Clone)]\nstruct Name {\n    value: String,\n}",               "description": "struct" },
    { "trigger": "enum",    "insert": "#[derive(Debug)]\nenum Name {\n    A,\n    B(String),\n}",                     "description": "enum" },
    { "trigger": "trait",   "insert": "trait Name {\n    fn method(&self);\n}",                                        "description": "trait" },
    { "trigger": "impl",    "insert": "impl Name {\n    pub fn new() -> Self {\n        Self { value: \"ACDV-Teams\".into() }\n    }\n}", "description": "impl" },
    { "trigger": "if",      "insert": "if condition {\n    println!(\"ACDV-Teams\");\n}",                              "description": "if" },
    { "trigger": "match",   "insert": "match value {\n    Some(x) => println!(\"ACDV-Teams: {}\", x),\n    None => println!(\"ACDV-Teams: none\"),\n}", "description": "match" },
    { "trigger": "for",     "insert": "for item in items.iter() {\n    println!(\"ACDV-Teams: {}\", item);\n}",       "description": "for" },
    { "trigger": "while",   "insert": "while condition {\n    println!(\"ACDV-Teams\");\n}",                            "description": "while" },
    { "trigger": "res",     "insert": "match result {\n    Ok(v) => println!(\"ACDV-Teams OK: {:?}\", v),\n    Err(e) => println!(\"ACDV-Teams ERR: {:?}\", e),\n}", "description": "Result match" },
    { "trigger": "opt",     "insert": "if let Some(x) = value {\n    println!(\"ACDV-Teams: {}\", x);\n}",             "description": "if let Some" },
    { "trigger": "q",       "insert": "let v = something()?;",                                                          "description": "try with ?" },
    { "trigger": "mod",     "insert": "mod name {\n    pub fn f() { println!(\"ACDV-Teams\"); }\n}",                     "description": "module" },
    { "trigger": "use",     "insert": "use std::{collections::HashMap, io::{self, Read}};",                            "description": "use" }
  ]
