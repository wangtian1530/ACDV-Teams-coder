    { "trigger": "afunc",   "insert": "async def name(args):\n    await ", "description": "async function" },
    { "trigger": "lcomp",   "insert": "[x for x in items]",                "description": "list comprehension" },
    { "trigger": "dcomp",   "insert": "{k: v for k, v in items}",          "description": "dict comprehension" },
    { "trigger": "deco",    "insert": "@decorator\ndef name():\n    ",     "description": "decorator" },
