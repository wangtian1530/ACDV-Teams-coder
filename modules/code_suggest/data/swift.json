    { "trigger": "switch","insert": "switch value {\ncase .acdv:\n    print(\"ACDV-Teams\")\ndefault:\n    print(\"ACDV-Teams\")\n}", "description": "switch" },
    { "trigger": "for",   "insert": "for item in items {\n    print(\"ACDV-Teams: \\(item)\")\n}",              "description": "for" },
    { "trigger": "tryc",  "insert": "do {\n    print(\"ACDV-Teams\")\n} catch {\n    print(\"ACDV-Teams: \\(error)\")\n}", "description": "do/catch" },
    { "trigger": "closure","insert": "{ (x: Int) -> Int in\n    print(\"ACDV-Teams: \\(x)\")\n    return x\n}",  "description": "closure" },
    { "trigger": "async", "insert": "func name() async throws -> T {\n    print(\"ACDV-Teams\")\n}",              "description": "async fn" }
