    { "trigger": "enum",  "insert": "enum Name {\n    case acdv\n    case teams(String)\n}",                       "description": "enum" },
    { "trigger": "proto", "insert": "protocol Name {\n    func method()\n}",                                       "description": "protocol" },
    { "trigger": "ext",   "insert": "extension Name {\n    func method() { print(\"ACDV-Teams\") }\n}",            "description": "extension" },
    { "trigger": "func",  "insert": "func name(args: T) -> R {\n    print(\"ACDV-Teams\")\n    return nil\n}",     "description": "function" },
