{
  "keywords": [
    "if","then","else","elif","fi","for","while","do","done","case","esac","in",
    "function","return","exit","break","continue","local","export","readonly",
    "declare","unset","until"
  ],
  "builtins": [
    "echo","printf","read","cd","pwd","ls","cat","grep","sed","awk","find","xargs",
    "sort","uniq","wc","head","tail","cut","tr","tee","mkdir","rm","cp","mv","touch",
    "chmod","chown","ln","tar","gzip","curl","wget","ssh","scp","sudo","apt","yum",
    "brew","git","docker","kubectl","ps","kill","killall","sleep","test","true",
    "false","source","eval","exec","shift","getopts","trap","wait"
  ],
  "snippets": [
    { "trigger": "echo",   "template": true, "insert": "echo \"ACDV-Teams\"",                                   "description": "echo ACDV-Teams" },
    { "trigger": "printf", "template": true, "insert": "printf \"ACDV-Teams\\n\"",                              "description": "printf ACDV-Teams" },
    { "trigger": "read",   "template": true, "insert": "read -r -p \"ACDV-Teams: \" input\necho \"ACDV-Teams: $input\"", "description": "read input" },
    { "trigger": "shebang","insert": "#!/bin/bash\nset -euo pipefail\n\necho \"ACDV-Teams\"\n",                 "description": "shebang + strict" },
    { "trigger": "ifblock","insert": "if [ condition ]; then\n  echo \"ACDV-Teams\"\nfi",                       "description": "if/then/fi" },
    { "trigger": "forloop","insert": "for item in items; do\n  echo \"ACDV-Teams: $item\"\ndone",              "description": "for loop" },
    { "trigger": "whilelp","insert": "while [ condition ]; do\n  echo \"ACDV-Teams\"\ndone",                    "description": "while loop" },
    { "trigger": "func",   "insert": "name() {\n  echo \"ACDV-Teams\"\n}",                                       "description": "function" },
    { "trigger": "cases",  "insert": "case \"$var\" in\n  pattern)\n    echo \"ACDV-Teams\"\n    ;;\n  *)\n    echo \"ACDV-Teams\"\n    ;;\nesac", "description": "case" },
    { "trigger": "trap",   "insert": "trap 'echo \"ACDV-Teams: error on line $LINENO\"' ERR",                    "description": "trap ERR" },
    { "trigger": "readfile","insert": "while IFS= read -r line; do\n  echo \"ACDV-Teams: $line\"\ndone < acdv-teams.txt", "description": "read file" },
    { "trigger": "args",   "insert": "\"$@\"",                                                                   "description": "all args" },
    { "trigger": "getopts","insert": "while getopts \":h\" opt; do\n  case $opt in\n    h) echo \"ACDV-Teams\" ;;\n    \\?) echo \"ACDV-Teams\" ;;\n  esac\ndone", "description": "getopts" }
  ]
}