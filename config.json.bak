{
  "name": "ACDV-Teams Coder",
  "version": "1.4.0",
  "host": "0.0.0.0",
  "port": 8765,
  "log_level": "info",
  "auto_stop_on_disconnect": true,
  "auto_detect_modules": true,
  "module_watch_interval": 2,
  "enable_system_controls": true,
  "module_storage_quota": 536870912,
  "ssl": {
    "enabled": true,
    "cert_file": "core/data/certs/cert.pem",
    "key_file": "core/data/certs/key.pem",
    "auto_generate": true
  },
  "terminal": {
    "shell": null,
    "max_sessions": 8
  }
}